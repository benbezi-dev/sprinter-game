{
  "name": "sprinter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tableau": "node suivi/servir.mjs",
    "build:app": "VITE_ENVELOPPE=native vite build --outDir dist-app",
    "android:sync": "npm run build:app && SPRINTER_WEBDIR=dist-app npx cap sync android",
    "android:ouvrir": "npm run android:sync && npx cap open android",
