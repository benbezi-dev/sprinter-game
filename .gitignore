node_modules/
dist/
# Le build de la version de test, produit par le workflow.
dist-test/
dist-app/
*.tsbuildinfo
.DS_Store
worker/node_modules/
worker/.wrangler/

# Suivi interne : feuille de route, dates de sortie, decisions. Le depot est
# public — ce tableau ne l'est pas.
suivi/
# Contrats, accords de confidentialite, pieces d'anteriorite. Le depot est
# public : y committer un NDA reviendrait a le publier, et une piece
# d'anteriorite publiee ne prouve plus rien d'anterieur.
juridique/
# Strategie de communication : ton, vocabulaire, calendrier de lancement.
# Le depot est public, et une charte editoriale lisible par tous perd la
# moitie de son interet. Le dossier docs/ reste libre pour de la
# documentation publique — c'est ce fichier-ci, et lui seul, qui sort.
docs/instagram_charte.md

# Configuration locale de l'outillage : chemins absolus propres a la machine.
.claude/

# Secrets de developpement wrangler.
worker/.dev.vars

# Le compte de service Firebase, celui qui autorise a envoyer une notification
# a n'importe quel telephone du parc. Google le livre sous ce nom-la. Il vit
# dans un secret wrangler (`npx wrangler secret put FCM_COMPTE_SERVICE`), et
# jamais dans le depot : celui-ci est public, et une cle publiee ne se retire
# pas — elle se revoque, et il faut alors la remplacer partout.
*-firebase-adminsdk-*.json
fcm-compte-service*.json

# Enveloppes natives : regenerees par `npx cap add` et `npx cap sync`, elles
# pesent lourd et contiennent des chemins de machine. Les sources qui comptent
# sont capacitor.config.ts et assets-stores/.
ios/App/App/public/
# Les liens symboliques vers node_modules que `npx cap sync ios` pose pour
# resoudre la collision de paquets Swift de Firebase (voir capacitor.config.ts).
# Ils pointent dans node_modules, qui n'est pas suivi : les committer ne
# donnerait que des liens casses sur une autre machine.
ios/App/CapApp-SPM/symlinks/
ios/App/Pods/
ios/DerivedData/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/

# Le trousseau de signature Android et ses mots de passe. Perdre ce trousseau,
# c'est perdre le droit de mettre l'application a jour ; le laisser fuir est
# pire encore : une cle de signature qui a fuite ne se retire pas, elle se
# remplace, et l'application ne se met alors plus a jour pour ceux qui l'ont
# deja installee. Ces fichiers n'ont jamais ete suivis, mais rien ne les en
# empechait — un seul `git add -A` suffisait.
# Une regle large plutot qu'une liste : c'est la seule qui tienne quand le
# fichier suivant s'appellera « keystore - copie 2.txt ».
android/keystore*
# Le modele, lui, se suit : il documente le fichier ci-dessus et ne porte que
# des valeurs a remplir. Il a deja vecu dans le depot (5aedd64).
!android/keystore.properties.exemple
*.jks
*.keystore
# Icônes PWA regenerees par @capacitor/assets a la racine.
/icons/

# Une copie complete du projet posee a la racine du projet. Elle est arrivee
# par un rapatriement, elle pese pres d'un giga et elle porte son propre .git :
# un seul `git add -A` la publiait sur un depot public. Le chemin est ancre par
# le slash de tete — un dossier `src/sprinter/` resterait suivi.
/sprinter/
# Les copies de securite prises avant une modification (`fichier.tsx.bak-avant-
# truc-20260904-1402`). Elles vivent a cote du fichier qu'elles doublent, donc
# dans src/ : rien ne les distinguait d'une source, et publier une source
# n'etait qu'une question de temps.
*.bak-*

# L'outillage des films promo vit chez lui, avec ses quatre-vingts megaoctets
# de binaire ffmpeg. Il ne doit surtout pas remonter dans le depot.
assets-stores/promo/node_modules/

# Les SORTIES des films d'explication : 34 Mo de MP4 et 43 Mo de PNG, refaites
# a l'identique par `node explications/rendu.mjs photos` puis `film`, et
# `./explications/encoder.sh`. Verifie : l'outillage repart de sa nouvelle
# place et refabrique les deux. Ce que git ne sait pas faire, c'est oublier —
# 77 Mo qui entrent y restent, dans chaque clone, pour toujours.
assets-stores/promo/explications/videos/
assets-stores/promo/explications/photos/

# Et la video « nouveautes » elle-meme, 15 Mo, pour la meme raison : elle se
# refait par `node source-video/render.mjs full` puis `./source-video/encode.sh`.
# Ce n'etait plus vrai avant aujourd'hui — les chemins de l'encodeur dataient
# d'un deplacement de dossier et pointaient vers un promo/frames qui n'existe
# pas. Repares et verifies de bout en bout, rendu puis encodage.
#
# La couverture reste, elle : 1,7 Mo, et rien ne dit qu'elle soit fabriquee
# plutot que choisie a la main. Ce qu'on ne sait pas refaire, on le garde.
assets-stores/promo/sprinter-nouveautes-1080x1920.mp4
assets-stores/promo/out/

# Intermediaires de rendu des films promo — refabricables, et lourds.
assets-stores/promo/source-video/frames/
assets-stores/promo/source-video/preview/
assets-stores/promo/out/
assets-stores/promo/explications/images/
assets-stores/promo/explications/controle/

# Les images intermediaires des captures Instagram : une suite de JPEG
# 1080 x 1920 par fonctionnalite, 2,3 Go en tout. Le rush livre
# (`*_raw_v1.mp4`) porte la meme matiere ; ce dossier ne sert qu'a remonter un
# reel sans refilmer, et se supprime sans rien perdre d'irremplacable.
content/instagram/gameplay/_travail/

# Les rushes et les visuels Instagram. Le dossier `content/` garde ses
# scripts — le harnais qui fabrique les videos est du code, il se versionne —
# mais pas ce qu'ils produisent : cent mega-octets de .mp4 dans un depot
# public, c'est un depot qu'on ne clone plus, et une video poussee ne se
# retire pas de l'historique en la supprimant.
content/**/*.mp4
content/**/*.jpg
content/**/*.png
# Un lien symbolique vers un node_modules de cette machine : il ne veut rien
# dire ailleurs.
content/instagram/gameplay/harnais/node_modules

# Traces de session du navigateur pilote. Rien a garder.
.playwright-mcp/

# Sorties de la chaine Blender : rendus, sequences de verification, videos.
# Tout se reengendre avec tools/blender/ — seules les mesures recopiees dans
# src/game/coureur-hd.js font partie du jeu.
tools/blender/sortie/
__pycache__/
